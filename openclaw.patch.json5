{
  models: {
    providers: {
      "ai-relay": {
        models: [
          {
            id: "tools",
            name: "AI Relay Tools",
            contextWindow: 200000,
            maxTokens: 8192,
            reasoning: true,
            compat: {
              supportsTools: true,
              supportsUsageInStreaming: true,
              supportsReasoningEffort: true,
              supportedReasoningEfforts: ["low", "medium", "high"]
            }
          },
          {
            id: "chat",
            name: "AI Relay Chat",
            contextWindow: 200000,
            maxTokens: 8192,
            reasoning: true,
            compat: {
              supportsTools: false,
              supportsUsageInStreaming: true,
              supportsReasoningEffort: true,
              supportedReasoningEfforts: ["low", "medium", "high"]
            }
          }
        ]
      }
    }
  },
  agents: {
    defaults: {
      model: {
        primary: "ai-relay/tools"
      },
      models: {
        "ai-relay/tools": {
          alias: "Relay Tools",
          params: { thinking: "medium" }
        },
        "ai-relay/chat": {
          alias: "Relay Chat",
          params: { thinking: "medium" }
        },
        "ai-relay/auto": null,
        "ai-relay/fast": null,
        "ai-relay/smart": null,
        "ai-relay/glm": null
      }
    },
    entries: {
      main: {
        model: "ai-relay/tools",
        models: {
          "ai-relay/tools": {
            agentRuntime: {
              id: "openclaw"
            }
          },
          "ai-relay/auto": null
        }
      }
    }
  }
}
